# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL & NEXT_PUBLIC_APP_URL: Domain aplikasi production (e.g. https://narativa.id or https://narativa.vercel.app)
APP_URL="https://narativa.id"
NEXT_PUBLIC_APP_URL="https://narativa.id"

# NEON POSTGRESQL PRODUCTION CONNECTION STRING
# Dapatkan dari Neon Console (pooled connection string dengan sslmode=require)
DATABASE_URL="postgresql://narativa_prod_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/narativa_production?sslmode=require"

# CLERK AUTHENTICATION (PRODUCTION)
# Dapatkan dari Clerk Dashboard > API Keys (Production Instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_YOUR_CLERK_PUBLISHABLE_KEY"
VITE_CLERK_PUBLISHABLE_KEY="pk_live_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_live_YOUR_CLERK_SECRET_KEY"

# CLERK WEBHOOK SYNC (SVIX)
# Dapatkan dari Clerk Dashboard > Webhooks > Endpoint Secret (whsec_...)
# Daftarkan endpoint: https://<domain-production>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET="whsec_YOUR_CLERK_WEBHOOK_SIGNING_SECRET"

# CLERK ROUTING PATHS
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/masuk"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/daftar"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# BUNNY STREAM CDN & TOKEN AUTHENTICATION (PRODUCTION)
# Hostname CDN Video Library Bunny Stream (pull zone/stream zone)
BUNNY_STREAM_CDN_HOSTNAME="vz-broll.narativa-stream.b-cdn.net"
# Token Authentication Key (SHA-256) dari Bunny Stream Security Settings
BUNNY_STREAM_TOKEN_AUTH_KEY="narativa_bunny_secret_token_key_2026"
# Library ID Bunny Stream
BUNNY_STREAM_LIBRARY_ID="348912"
# Masa berlaku signed URL dalam detik (default: 3600 detik = 1 jam)
BUNNY_SIGNED_URL_TTL_SEC="3600"

# SCRIPT CREATION DAILY QUOTA
SCRIPT_DAILY_LIMIT_PER_USER="20"
